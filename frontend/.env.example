# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL the browser uses to reach the Go gateway.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Optional. The browser pings this to wake the AI service before an analysis
# needs it: a parked instance on the free tier is woken by requests from
# outside the platform, and not by the gateway's. Leave it empty locally.
NEXT_PUBLIC_AI_SERVICE_URL=

# Public origin of the app — used for OpenGraph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
