# Port the gateway listens on.
PORT=8080

# `development` or `production`. Production switches Gin into release mode.
ENVIRONMENT=development

# Base URL of the Python AI service.
AI_SERVICE_URL=http://localhost:8000

# Optional shared secret sent to the AI service as `X-Internal-Token`. Must match
# the AI service's INTERNAL_API_KEY. Leave empty to disable.
INTERNAL_API_KEY=

# Supabase project URL. The gateway derives the JWKS endpoint from it
# (<url>/auth/v1/.well-known/jwks.json) to verify the ES256/RS256 signature of
# incoming access tokens — no shared secret required.
SUPABASE_URL=https://your-project-ref.supabase.co

# Comma-separated CORS allow list.
ALLOWED_ORIGINS=http://localhost:3000

# Per-user request budget for POST /analyze.
RATE_LIMIT_RPM=20

# Maximum accepted CV upload size, in megabytes.
MAX_UPLOAD_MB=5

# Upstream timeout for a single analysis call, in seconds.
REQUEST_TIMEOUT_SECONDS=60

# Optional shared cache. Without it the gateway still caches in process.
# Local: redis://localhost:6379 — managed instances use rediss://
REDIS_URL=
# Lifetime of a cached analysis. 0 turns caching off.
CACHE_TTL_HOURS=168
# Entries held in process, in front of Redis.
CACHE_LOCAL_ENTRIES=256

# Job queue. Empty means this process does not touch the queue at all.
# Prefer the transaction pooler over the direct connection.
DATABASE_URL=
# Run the queue worker inside this process.
RUN_WORKER=false
WORKER_CONCURRENCY=2
# How long one background attempt may take. Separate from REQUEST_TIMEOUT_SECONDS
# on purpose: nobody is holding a connection open for a queued job.
JOB_TIMEOUT_SECONDS=120
# Retention for finished jobs. Dead letters outlive successes.
JOB_RETENTION_HOURS=24
DLQ_RETENTION_HOURS=168

# Tracing. Setting an endpoint is what turns it on; leave it empty and spans are
# not exported and nothing else changes. The exporter reads its headers and
# protocol from the other standard OTEL_* variables, which is what a backend's
# own setup instructions hand you.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...
# Share of traces recorded when nothing upstream has already decided.
TRACE_SAMPLE_RATIO=1
